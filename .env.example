# ---------------------------------------------------------------------------
# Student Resume Analyzer - Environment Configuration Template
# Copy this file to .env and adjust variables as necessary for your local setup.
# ---------------------------------------------------------------------------

# Application Settings
APP_NAME="Student Resume Analyzer"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Allowed Origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# Document Upload Configuration (PDF & DOCX)
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=["pdf", "docx"]

# Model & Taxonomy Paths (Planned Phase 4 & 5)
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# TAXONOMY_PATH=data/taxonomy/skills_esco.json
